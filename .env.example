# ==============================================================================
# 연세 119 응급실 정보 시스템 - 환경변수 템플릿 (.env.example)
# 사용법: 이 파일을 `.env`로 복사한 뒤 본인의 실제 인증키를 채워 넣으세요.
# (`application.yml`의 `spring.config.import` 설정이 `.env`를 자동으로 읽어 들입니다.)
# ==============================================================================

# 1. 공공데이터포털 국립중앙의료원(NEMC) 응급의료정보조회서비스 일반 인증키 (Encoding/Decoding 모두 지원)
NEMC_API_SERVICE_KEY=YOUR_DATA_GO_KR_SERVICE_KEY

# 2. 네이버 클라우드 플랫폼(NCP) Maps API 인증 정보
NAVER_MAP_CLIENT_ID=YOUR_NCP_CLIENT_ID
NAVER_MAP_CLIENT_SECRET=YOUR_NCP_CLIENT_SECRET
NAVER_MAP_DARK_STYLE_ID=4b12b380-f70c-4d42-85df-ecf7961ff041
